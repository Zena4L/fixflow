#!/bin/bash -e

# If running the rails server then create or migrate existing database.
# Migrations take advisory locks, which a transaction-mode pooler (Neon's
# pooled URL) does not support, so prefer the direct connection when given.
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  DATABASE_URL="${DATABASE_URL_UNPOOLED:-$DATABASE_URL}" ./bin/rails db:prepare
fi

exec "${@}"
