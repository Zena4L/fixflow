<% content_for :title, "FixFlow" %>
<main class="min-h-screen bg-gray-50 dark:bg-gray-900 px-4 py-16">
  <div class="mx-auto max-w-3xl">
    <header class="text-center">
      <h1 class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white">FixFlow</h1>
      <p class="mt-3 text-lg text-gray-600 dark:text-gray-300">
        Raise a request, follow its progress, and get it fixed.
      </p>
    </header>

    <div class="mt-12 grid gap-6 sm:grid-cols-2">
      <section aria-labelledby="requesters-heading" class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <h2 id="requesters-heading" class="text-xl font-semibold text-gray-900 dark:text-white">Need help?</h2>
        <p class="mt-2 text-gray-600 dark:text-gray-300">Submit a request and track it until it is resolved.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <%= link_to "Sign in", rodauth(:user).login_path, class: "rounded-md bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
          <%= link_to "Create an account", rodauth(:user).create_account_path, class: "rounded-md border border-gray-300 px-4 py-2 font-medium text-gray-700 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-700" %>
        </div>
      </section>

      <section aria-labelledby="staff-heading" class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800">
        <h2 id="staff-heading" class="text-xl font-semibold text-gray-900 dark:text-white">Staff</h2>
        <p class="mt-2 text-gray-600 dark:text-gray-300">Triage, assign and resolve requests from the queue.</p>
        <div class="mt-6">
          <%= link_to "Staff sign in", rodauth(:staff_member).login_path, class: "rounded-md bg-gray-900 px-4 py-2 font-medium text-white hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 dark:bg-gray-100 dark:text-gray-900 dark:hover:bg-white" %>
        </div>
      </section>
    </div>
  </div>
</main>
